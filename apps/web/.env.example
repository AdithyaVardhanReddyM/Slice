# Convex — CONVEX_URL from packages/backend/.env.local (written by `convex dev`)
NEXT_PUBLIC_CONVEX_URL=

# Clerk — dashboard.clerk.com → your app → API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Where the concierge agent server runs (apps/agent); /api/concierge proxies to it
AGENT_URL=http://localhost:8000
# Where product images and demo stores are served from
NEXT_PUBLIC_STORES_URL=http://localhost:3002
