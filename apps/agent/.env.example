# Gemini via Vertex AI (Gemini Enterprise Agent Platform), not AI Studio
GOOGLE_GENAI_USE_ENTERPRISE=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# gemini-3.8-flash is only served from `global`
GOOGLE_CLOUD_LOCATION=global

# Local dev only: absolute path to a service account key with the Vertex AI User role.
# On Agent Runtime the agent uses its own service identity, so this stays unset there.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# Qloo goes through the Convex cache (packages/backend/convex/qloo.ts), never direct.
# CONVEX_SITE_URL is in packages/backend/.env.local; the secret matches Convex's QLOO_PROXY_SECRET.
CONVEX_SITE_URL=https://your-deployment.convex.site
QLOO_PROXY_SECRET=

# Origins allowed to call the agent server directly (the Next.js app proxies for the widget).
AGENT_ALLOW_ORIGINS=http://localhost:3000
CONVEX_URL=https://your-deployment.convex.cloud

# --- Pages service -------------------------------------------------------------
# Firecrawl v2 (https://docs.firecrawl.dev) crawls public brand sites during intake.
# Optional: localhost URLs and a missing key fall back to a direct fetch.
FIRECRAWL_API_KEY=
# Pexels photo search (https://www.pexels.com/api/), the default imagery source.
PEXELS_API_KEY=
# Google's image models on Vertex (Gemini Enterprise Agent Platform), used by generate_image.
# Nano Banana 2 = Gemini 3.1 Flash Image, Nano Banana Pro = Gemini 3 Pro Image.
# Model ids checked 2026-10-11 against Google's prompting guide and third-party Vertex notes:
# the GA ids are gemini-3.1-flash-image and gemini-3-pro-image (the -preview ids from 2025
# were retired, and gemini-3.1-flash-lite-image exists as a cheaper tier). Verify against
# the Vertex model garden if generation returns 404.
NANO_BANANA_2_MODEL=gemini-3.1-flash-image
NANO_BANANA_PRO_MODEL=gemini-3-pro-image
